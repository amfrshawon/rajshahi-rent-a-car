{
  "name": "rajshahi-rent-a-car",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run images && next dev",
    "build": "npm run images && next build && npm run slugs && npm run verify:routes && npm run verify:pages",
    "start": "next start",
    "lint": "eslint",
    "build:only": "next build",
    "verify:pages": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-pages.mts",
    "verify:routes": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-legacy-routes.mts",
    "images": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-images.mts",
    "slugs": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/localise-slugs.mts",
    "verify:blog": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-blog.mts"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "marked": "^18.0.14",
    "next": "^16.4.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.13.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "description": "রাজশাহী রেন্ট এ কার — bilingual (bn/en) car rental site for Rajshahi, Bangladesh"
}
